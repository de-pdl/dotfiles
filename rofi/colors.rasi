* {
    /* ── Matugen palette ───────────────────────────── */
    primary:          #cdbdff;
    on-primary:       #34275e;
    primary-container:    #4b3e76;
    on-primary-container: #e8ddff;

    secondary:        #cbc3dc;
    on-secondary:     #322e41;

    surface:          #141318;
    on-surface:       #e6e1e9;
    surface-variant:  #48454e;
    on-surface-variant: #cac4cf;

    background:       #141318;
    on-background:    #e6e1e9;

    error:            #ffb4ab;
    on-error:         #690005;

    outline:          #938f99;
    outline-variant:  #48454e;

    /* ── Semantic aliases (everything references these) ── */
    bg:               @background;
    bg-alt:           @surface-variant;
    fg:               @on-background;
    fg-dim:           @on-surface-variant;

    accent:           @primary;
    accent-fg:        @on-primary;
    accent-subtle:    @primary-container;
    accent-subtle-fg: @on-primary-container;

    urgent:           @error;
    urgent-fg:        @on-error;

    border-color:     @outline-variant;
    selected-bg:      @primary;
    selected-fg:      @on-primary;

    /* ── Rofi internals ────────────────────────────── */
    background-color: transparent;
    text-color:       @fg;
}
