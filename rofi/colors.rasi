* {
    /* ── Matugen palette ───────────────────────────── */
    primary:          #abc7ff;
    on-primary:       #0d2f5f;
    primary-container:    #294677;
    on-primary-container: #d7e2ff;

    secondary:        #bec6dc;
    on-secondary:     #283041;

    surface:          #111318;
    on-surface:       #e2e2e9;
    surface-variant:  #44474e;
    on-surface-variant: #c4c6d0;

    background:       #111318;
    on-background:    #e2e2e9;

    error:            #ffb4ab;
    on-error:         #690005;

    outline:          #8e9099;
    outline-variant:  #44474e;

    /* ── Semantic aliases (everything references these) ── */
    bg:               @background;
    bg-alt:           @surface-variant;
    fg:               @on-background;
    fg-dim:           @on-surface-variant;

    accent:           @primary;
    accent-fg:        @on-primary;
    accent-subtle:    @primary-container;
    accent-subtle-fg: @on-primary-container;

    urgent:           @error;
    urgent-fg:        @on-error;

    border-color:     @outline-variant;
    selected-bg:      @primary;
    selected-fg:      @on-primary;

    /* ── Rofi internals ────────────────────────────── */
    background-color: transparent;
    text-color:       @fg;
}
