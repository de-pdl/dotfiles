* {
    /* ── Matugen palette ───────────────────────────── */
    primary:          #e5b6f2;
    on-primary:       #452153;
    primary-container:    #5d386b;
    on-primary-container: #f9d8ff;

    secondary:        #d5c0d7;
    on-secondary:     #392c3d;

    surface:          #161217;
    on-surface:       #eae0e7;
    surface-variant:  #4c444d;
    on-surface-variant: #cec3cd;

    background:       #161217;
    on-background:    #eae0e7;

    error:            #ffb4ab;
    on-error:         #690005;

    outline:          #988e97;
    outline-variant:  #4c444d;

    /* ── Semantic aliases (everything references these) ── */
    bg:               @background;
    bg-alt:           @surface-variant;
    fg:               @on-background;
    fg-dim:           @on-surface-variant;

    accent:           @primary;
    accent-fg:        @on-primary;
    accent-subtle:    @primary-container;
    accent-subtle-fg: @on-primary-container;

    urgent:           @error;
    urgent-fg:        @on-error;

    border-color:     @outline-variant;
    selected-bg:      @primary;
    selected-fg:      @on-primary;

    /* ── Rofi internals ────────────────────────────── */
    background-color: transparent;
    text-color:       @fg;
}
