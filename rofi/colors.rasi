* {
    /* ── Matugen palette ───────────────────────────── */
    primary:          #bbc3ff;
    on-primary:       #232c61;
    primary-container:    #3a4379;
    on-primary-container: #dee0ff;

    secondary:        #c3c5dd;
    on-secondary:     #2d2f42;

    surface:          #121318;
    on-surface:       #e4e1e9;
    surface-variant:  #46464f;
    on-surface-variant: #c7c5d0;

    background:       #121318;
    on-background:    #e4e1e9;

    error:            #ffb4ab;
    on-error:         #690005;

    outline:          #90909a;
    outline-variant:  #46464f;

    /* ── Semantic aliases (everything references these) ── */
    bg:               @background;
    bg-alt:           @surface-variant;
    fg:               @on-background;
    fg-dim:           @on-surface-variant;

    accent:           @primary;
    accent-fg:        @on-primary;
    accent-subtle:    @primary-container;
    accent-subtle-fg: @on-primary-container;

    urgent:           @error;
    urgent-fg:        @on-error;

    border-color:     @outline-variant;
    selected-bg:      @primary;
    selected-fg:      @on-primary;

    /* ── Rofi internals ────────────────────────────── */
    background-color: transparent;
    text-color:       @fg;
}
