/*─────────────────────────────────────────────────
  Compact menu theme for rice_farm pickers.
  Same look as theme.rasi (matugen-driven colors.rasi),
  sized for short option lists instead of drun/run.
─────────────────────────────────────────────────*/
@import "colors.rasi"

window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @border-color;
    border-radius:    14px;
    width:            380px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0px;
    padding:          12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
    margin:           0px 0px 10px 0px;
    children:         [ prompt, textbox-prompt-colon, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @fg-dim;
    str:              "·";
}

entry {
    background-color: transparent;
    text-color:       @urgent;
    placeholder:      "Search...";
    placeholder-color: @fg-dim;
    cursor:           text;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            6;
    scrollbar:        false;
    spacing:          4px;
    fixed-height:     false;
    dynamic:          true;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          9px 12px;
    spacing:          10px;
    orientation:      horizontal;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @urgent;
    text-color:       @urgent-fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @urgent-fg;
}

element-icon {
    size:             20px;
    cursor:           pointer;
}

element-text {
    vertical-align:   0.5;
    cursor:           pointer;
    highlight:        @accent-fg;
}

message {
    background-color: @accent-subtle;
    border-radius:    8px;
    padding:          8px 12px;
    margin:           0px 0px 10px 0px;
}

textbox {
    background-color: transparent;
    text-color:       @accent-subtle-fg;
}
