/* cc_gallery.rasi — theme for the Control Center's wallpaper gallery, a
   standalone rofi process launched by menu.sh's relaunch loop (the CC
   backend exits 7 on the gallery page — see control_center.sh header).

   WHY A RELAUNCH: rofi loads its theme at window creation and a script-mode
   "\0theme" snippet cannot re-layout geometry (rofi 2.0, verified live
   2026-09-26: the in-place variant stayed a single column). Running the
   gallery as its own rofi process with THIS theme is the faithful port of
   the old standalone rofi/gallery.rasi picker; menu.sh guarantees the CC
   window has fully exited before the gallery starts, so two rofi windows
   never stack.

   Values ported from rofi/gallery.rasi (cronos): 85%x90% window, 4x3 grid,
   220px icons, hidden element text (font "Monospace 0" + transparent
   color), disabled inputbar, palette via the shared colors.rasi import. */

@import "~/.config/rofi/colors.rasi"

window {
    width:            85%;
    height:           90%;
}

mainbox {
    background-color: transparent;
    children:         [ listview ];
    spacing:          0px;
    padding:          0px;
}

inputbar {
    enabled:          false;
}

listview {
    background-color: transparent;
    columns:          4;
    lines:            3;
    fixed-height:     true;
    spacing:          8px;
}

element {
    orientation:      vertical;
    spacing:          6px;
    padding:          4px;
    border-radius:    10px;
    background-color: transparent;
}

element selected.normal {
    background-color: @accent-subtle;
    border:           2px solid;
    border-color:     @accent;
    text-color:       @accent-subtle-fg;
}

element-icon {
    size:             220px;
    cursor:           pointer;
}

element-text {
    font:             "Monospace 0";
    text-color:       rgba(0, 0, 0, 0);
    horizontal-align: 0.5;
    cursor:           pointer;
}
