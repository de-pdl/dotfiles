@import "~/.config/rofi/colors.rasi"

/*─────────────────────────────────────────────────
  CONTROL CENTER THEME
  Same matugen palette variables as theme.rasi
  (colors.rasi: @bg @bg-alt @fg @fg-dim @accent ...).
  Window 640px, radius 14, 2px border.
─────────────────────────────────────────────────*/
window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @border-color;
    border-radius:    14px;
    width:            640px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0px;
    padding:          12px;
}

/*─────────────────────────────────────────────────
  INPUT BAR (kept: script mode needs the entry widget)
─────────────────────────────────────────────────*/
inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
    margin:           0px 0px 10px 0px;
    children:         [ prompt, textbox-prompt-colon, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @fg-dim;
    str:              "·";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Rice control";
    placeholder-color: @fg-dim;
    cursor:           text;
}

/*─────────────────────────────────────────────────
  LIST
─────────────────────────────────────────────────*/
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    scrollbar:        false;
    spacing:          4px;
    fixed-height:     true;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          8px 10px;
    spacing:          10px;
    orientation:      horizontal;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @urgent;
    text-color:       @urgent-fg;
}

element normal.active {
    background-color: @accent-subtle;
    text-color:       @accent-subtle-fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @urgent-fg;
}

element selected.active {
    background-color: @accent;
    text-color:       @accent-fg;
}

element-text {
    vertical-align:   0.5;
    cursor:           pointer;
    highlight:        @accent-fg;
}

/*─────────────────────────────────────────────────
  MESSAGE BOX (errors / info)
─────────────────────────────────────────────────*/
message {
    background-color: @accent-subtle;
    border-radius:    8px;
    padding:          8px 12px;
    margin:           0px 0px 10px 0px;
}

textbox {
    background-color: transparent;
    text-color:       @accent-subtle-fg;
}
