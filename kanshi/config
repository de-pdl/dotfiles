# ============================================
# PC PROFILES
# ============================================

profile pc_standard {
    output "HDMI-A-2" mode 1920x1080@144.001Hz position 0,0
    output "DP-4"     mode 2560x1440@143.995Hz position 1920,0
}

profile pc_no_tv {
    output "HDMI-A-1" disable
    output "HDMI-A-2" mode 1920x1080@144.001Hz position 0,0
    output "DP-4"     mode 2560x1440@143.995Hz position 1920,0
}

profile pc_with_tv {
    output "HDMI-A-1" mode 1280x720@60Hz position 3840,0
    output "HDMI-A-2" mode 1920x1080@144.001Hz position 0,0
    output "DP-4"     mode 2560x1440@143.995Hz position 1920,0
}

# ============================================
# LAPTOP DOCKED PROFILES
# ============================================
profile laptop_docked {
    output "HDMI-A-2" mode 1920x1080@144Hz position 0,0
    output "DP-4"     mode 2560x1440@144Hz position 1920,0
    output "eDP-1"    mode 2256x1504@60Hz scale 1.5 position 2448,1440
}

profile laptop_clamshell {
    output "eDP-1"    disable
    output "HDMI-A-2" mode 1920x1080@144Hz position 0,0
    output "DP-4"     mode 2560x1440@144Hz position 1920,0
}

profile laptop_mobile {
    output "eDP-1"    mode 2256x1504@60Hz scale 1.5 position 0,0
}

profile laptop_one_external {
    output "eDP-1"    mode 2256x1504@60Hz scale 1.5 position 0,0
    output "HDMI-A-2" mode 1920x1080@60Hz  position 2400,0
    # Or DP-4 if that's the one at uni
}

# ============================================
# CATCH-ALL (Fallback)
# ============================================
profile catch_all {
    output "eDP-1" mode 2256x1504@60Hz scale 1.5 position 0,0
}
