# ---------------------------------------------------------
# PC / DOCKED: Side (Left) | Main (Right)
# ---------------------------------------------------------
profile pc_standard {
    output "HDMI-A-2" mode 1920x1080@144Hz position 0,0
    output "DP-4"     mode 2560x1440@144Hz position 1920,0
}

# ---------------------------------------------------------
# PC + TV: Side (Left) | Main (Center) | TV (Right)
# ---------------------------------------------------------
profile pc_with_tv {
    output "HDMI-A-2" mode 1920x1080@144Hz position 0,0
    output "DP-4"     mode 2560x1440@144Hz position 1920,0
    output "HDMI-A-1" mode 1280x720@60Hz   position 4480,0 # 1920 + 2560
}

# ---------------------------------------------------------
# LAPTOP DOCKED (Lid Open): Side | Main (Top) | Laptop (Bottom)
# ---------------------------------------------------------
profile laptop_docked {
    output "HDMI-A-2" mode 1920x1080@144Hz position 0,0
    output "DP-4"     mode 2560x1440@144Hz position 1920,0
    
    # Laptop is centered under the Main monitor
    # Math: Main starts at 1920. Logical width of laptop (2256 / 1.5) is ~1504.
    # (2560 - 1504) / 2 = 528. So 1920 + 528 = 2448.
    output "eDP-1"    mode 2256x1504@60Hz scale 1.5 position 2448,1440
}

# ---------------------------------------------------------
# LAPTOP CLAMSHELL: Side | Main (Lid Closed)
# ---------------------------------------------------------
profile laptop_clamshell {
    output "eDP-1"    disable
    output "HDMI-A-2" mode 1920x1080@144Hz position 0,0
    output "DP-4"     mode 2560x1440@144Hz position 1920,0
}

# ---------------------------------------------------------
# LAPTOP MOBILE: Just the internal screen
# ---------------------------------------------------------
profile laptop_mobile {
    output "eDP-1"    mode 2256x1504@60Hz scale 1.5 position 0,0
}
