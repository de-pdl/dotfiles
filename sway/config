set $mod Mod4
set $username "ayush"
font pango:Hack 9
floating_modifier $mod


exec_always --no-startup-id sh -c "/home/$username/.config/scripts/startup.sh"

# --- 2. Clamshell Mode ---
# When lid closes: disable internal screen. When opens: enable it.
# This triggers Scenario 4 automatically.
bindswitch --locked lid:on output eDP-1 disable
bindswitch --locked lid:off output eDP-1 enable

exec_always --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
for_window [app_id="Gnome-control-center"] floating enable
for_window [window_role="pop-up"] floating enable
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh

# start a terminal
set $term alacritty
bindsym $mod+Return exec $term

set $browser firefox
bindsym $mod+b exec $browser

# kill focused window
bindsym $mod+q kill

# start rofi (ensure you installed rofi-wayland)
bindsym ctrl+space exec "PATH=$PATH:$HOME/.local/bin rofi -show combi -modi window,run,combi -combi-modi window,run"
exec_always pkill waybar; waybar -c ~/.dotfiles/waybar/config -s ~/.dotfiles/waybar/style.css


bindsym $mod+Shift+c exec ~/.config/scripts/rice_farm/main_rice.sh

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# splits and layouts
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+t split toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+w sticky toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

## Screenshots (Wayland Native using grim and slurp)
# Full screen to file
bindsym Print exec grim ~/Pictures/$(date +%Y-%m-%d_%H-%M-%S).png

# Select area and save to file
bindsym Shift+Print exec grim -g "$(slurp)" ~/Pictures/$(date +%Y-%m-%d_%H-%M-%S).png

## Clipboard Screenshots
# Select area and copy to clipboard
bindsym Ctrl+Shift+s exec grim -g "$(slurp)" - | wl-copy -t image/png

# Active window to clipboard (Wayland equivalent of xdotool)
bindsym $mod+Ctrl+Print exec grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.type?) | select(.focused).rect | "\(.x),\(.y) \(.width)x\(.height)"')" - | wl-copy

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


bindsym $mod+Shift+r restart
# Sway exit prompt
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit Sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'"

mode "resize" {
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Window Colors
client.focused          #000000 #000000 #ffffff #000000   #000000
client.focused_inactive #000000 #000000 #ffffff #000000   #000000
client.unfocused        #000000 #000000 #888888 #000000   #000000
client.urgent           #000000 #000000 #ffffff #000000   #000000
client.placeholder      #000000 #000000 #ffffff #000000   #000000
client.background       #ffffff

# Floated windows (Using app_id for native Wayland apps, fallback to class for XWayland)
for_window [title="Calculator"] floating enable
for_window [title="Timer"] floating enable
for_window [app_id="^.*"] border pixel 1
for_window [class="^.*"] border pixel 1
for_window [app_id="librewolf"] border none
for_window [app_id="firefox"] border none
for_window [app_id="mpv"] floating enable
for_window [app_id="imv"] floating enable
for_window [app_id="zenity"] floating enable
for_window [app_id="cachyos-welcome"] floating enable

# Hotkeys (Audio/Brightness/OSD)
bindsym XF86MonBrightnessUp exec brightnessctl s +5% | grep -Po '[0-9]+(?=%)' > /tmp/xobpipe
bindsym XF86MonBrightnessDown exec brightnessctl s 5%- | grep -Po '[0-9]+(?=%)' > /tmp/xobpipe
bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\\[on\\]/ s/.*\\[([0-9]+)%\\].*/\\1/ p; /\\[off\\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

bindsym $mod+Shift+p exec gnome-calculator

# Swaylock (Replaces i3lock)
bindsym $mod+l exec "sleep 0.1 && swaylock -f -c 000000"
# Input settings stay here because they don't change based on monitors
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
    # These two lines fix the "sticky drag" issue
    drag enabled
    drag_lock disabled 
}
# The key here is the 'idlehint' and explicit 'lock' command
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
    before-sleep 'loginctl lock-session' \
    lock 'swaylock -f -c 000000' \
    unlock 'killall swaylock'
# Autostart
exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# xob (Ensure you compile/install xob with wayland support)
exec_always --no-startup-id mkfifo /tmp/xobpipe && tail -f /tmp/xobpipe | xob -t 2170 & disown
